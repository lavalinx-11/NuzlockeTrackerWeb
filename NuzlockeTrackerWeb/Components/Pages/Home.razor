        MyIdentity = "", // Player/User Identifier
        ErrorMessage = "", // Messages Used To Display Why The Player Can't Do Something (EX: Player Tries To Pick 2 Z Tiers And It Says No)
        SearchQuery = "", // What You're Searching
        SelectedSeries = "", // The Series The Player Just Selected
        SelectedTier = "", // The Tier The Player Just Selected
        RandomNameDisplay = "", // Used In The Animation To Randomize Teams
        BrowserId = Guid.NewGuid().ToString(), 
        TemporaryName = "";
    
    // Integer Declarations
    private int 
        PlayersPerTeam = 2, 
        CharIdCounter = 1;

    // Boolean Declarations
    private bool
        IsSpinning = false,
        ShowBans = false;
        
    private bool IsHost => MatchSession?.HostId == BrowserId;

    
