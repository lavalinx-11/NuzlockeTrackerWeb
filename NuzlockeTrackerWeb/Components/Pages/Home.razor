    @page "/"
    @rendermode InteractiveServer
    @using NuzlockeTrackerWeb.Components.GameData
    @using NuzlockeTrackerWeb.Data
    @using Microsoft.EntityFrameworkCore
    
    @inject IDbContextFactory<AppDbContext> DbFactory
    @inject NuzlockeSessionService SessionService
    @implements IDisposable

    @* --- DEBUG NAVIGATION --- *@
    <div class="d-flex justify-content-center gap-2 mb-4 bg-dark p-2 rounded shadow-sm sticky-top" style="z-index: 1000;">
        <button class="btn btn-sm btn-outline-secondary" @onclick='() => { if(matchSession!=null)  matchSession.Stage = MatchStage.Home; }'>Main Menu</button>
        </div>

    <div class="container py-4">
        @if (matchSession == null) {
        @* --- JOIN LOBBY --- *@
        <div class="text-center mt-5 reveal-card">
            <h1 class="display-4 fw-bold text-primary">ABA NUZLOCKE</h1>
            <div class="card bg-dark border-primary p-4 mt-4 mx-auto" style="max-width: 400px;">
                <button class="btn btn-primary mb-3" @onclick="CreateNewRoom">Host New Session</button>
                <div class="input-group">
                    <input @bind="joinCode" class="form-control bg-black text-white" placeholder="Enter Room Code" />
                    <button class="btn btn-outline-info" @onclick="JoinRoom">Join</button>
                </div>
                @if(!string.IsNullOrEmpty(errorMessage)) { 
                    <div 
                        class="text-danger mt-2 small">@errorMessage
                    </div> 
                }
            </div>
        </div>
        }
        else if (matchSession.Stage == MatchStage.Home) {
        @* --- SECTION: MAIN MENU --- *@
        <div class="text-center mt-5">
            <h1 class="display-4 fw-bold text-primary">ABA NUZLOCKE</h1>
            <div class="card bg-black border-secondary p-2 mb-4 mx-auto" style="max-width: 200px;">
                <small class="text-white">ROOM CODE</small>
                <h4 class="text-warning mb-0">@matchSession.Id</h4>
            </div>
            <div class="mt-4 d-grid gap-2 d-sm-block">
                @if (IsHost) {
                <button class="btn btn-primary btn-lg px-5 shadow me-sm-2" @onclick="InitializeSetup">Setup Room</button>
                } else {
                <div class="alert alert-secondary d-inline-block px-4 mb-0 me-sm-2">
                    <small class="text-uppercase fw-bold">Waiting for Host...</small>
                </div>
                }
                <a class="btn btn-outline-info btn-lg px-5 shadow" href="/stats">View Stats</a>
                </div>
        </div>
        }
       
      @* --- Room Setup --- *@
        else if (matchSession.Stage == MatchStage.Setup) {
        <h3 class="text-light mb-4">Room Setup</h3>
        <div class="card bg-dark text-light p-4 shadow border-secondary">
            <div class="mb-4">
                <label class="form-label">Players per Team:</label>
                <select @onchange="OnPlayerCountChange" class="form-select w-25 bg-secondary text-white border-0" disabled="@(!IsHost)">
                    <option value="2">2 (2v2)</option>
                    <option value="3">3 (3v3)</option>
                </select>
                @if(!IsHost){ <small class="text-muted">Only the host can change team size.</small> }
            </div>

            
            @* --- Player Slot Locking --- *@
            <h5 class="mb-3">Claim a Slot & Enter Name:</h5>
            <div class="row g-3">
                @foreach (Player user in matchSession.UnassignedPlayers) {
                    bool isLocked = user.IsLocked || (!string.IsNullOrEmpty(user.ClaimedBySessionId) && user.ClaimedBySessionId != browserId);
                    bool isClaimedByMe = user.ClaimedBySessionId == browserId;
                    bool iAlreadyHaveAClaim = matchSession.UnassignedPlayers.Any(other => other.ClaimedBySessionId == browserId);

                    <div class="col-md-4">
                        <div class="input-group">
                            @if (isClaimedByMe && !user.IsLocked) {
                                <input @bind="temporaryName" 
                                       class="form-control bg-dark text-white border-info shadow-glow-info" 
                                       placeholder="Your Name..." />
                                <button class="btn btn-info" @onclick="() => LockMyName(user)">LOCK</button>
                            }
                            
                            else {
                                <input value="@(string.IsNullOrEmpty(user.Name) ? "Empty Slot" : user.Name)" 
                                       class="form-control bg-dark text-white border-secondary" 
                                       disabled />
                
                                @if (!iAlreadyHaveAClaim && !isLocked) {
                                    <button class="btn btn-outline-info" @onclick="() => ClaimSlot(user)">CLAIM</button>
                                }
                                else if (isClaimedByMe && user.IsLocked) {
                                    <button class="btn btn-outline-warning" @onclick="() => UnlockName(user)">EDIT</button>
                                }
                            }
                        </div>
                    </div>
                }
            </div>

            
            @* --- Team Randomizer Button --- *@
            <div class="mt-5 text-center">
                @if (isSpinning) {
                <div class="p-4 border border-warning rounded bg-black">
                    <h2 class="text-warning slot-machine">@randomNameDisplay</h2>
                    <p class="text-white-50">RANDOMIZING TEAMS...</p>
                </div>
                } else {
                @if (IsHost) {
                <button class="btn btn-warning btn-lg fw-bold px-5 shadow" @onclick="WheelSpinTeams">
                    ⚡ SPIN & START DRAFT
                </button>
                } else {
                <div class="p-3 border border-info rounded bg-dark d-inline-block">
                    <span class="text-info animate-pulse fw-bold">WAITING FOR HOST TO SPIN...</span>
                </div>
                }
                }
                @if(!string.IsNullOrEmpty(errorMessage)) { <div class="text-danger mt-3">@errorMessage</div> }
            </div>
        </div>
        }
        
        
        @* --- Character Selection  --- *@

        else if (matchSession.Stage == MatchStage.CharacterSelect) {
        Player? activePicker = matchSession.PickingOrder.ElementAtOrDefault(matchSession.CurrentPickerIndex);
        bool isMyTurn = activePicker?.ClaimedBySessionId == browserId;
        <div class="alert alert-info text-center py-3">
            <h4 class="mb-0">Turn: <span class="fw-bold">@(activePicker?.Name ?? "...")</span></h4>
            <small class="text-uppercase">Picking for Team @activePicker?.TeamNumber</small>
            @if(isMyTurn) { <div class="text-danger fw-bold animate-pulse mt-1">YOUR TURN!</div> }
        </div>
        
        @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="alert alert-danger text-center fw-bold border-danger py-2 mb-3 reveal-card animate-pulse">
                    ⚠️ @errorMessage
                </div>
            }

            @* --- Bans Button --- *@

            <div class="text-center mb-3">
            <button class="btn btn-sm btn-outline-danger" @onclick="() => showBans = !showBans">Bans (@matchSession.CurrentBans.Count)</button>
            @if (showBans) {
            <div class="card card-body bg-dark border-danger p-2 mt-2">
                <div class="d-flex flex-wrap gap-1 justify-content-center mb-2">
                    @foreach (string ban in matchSession.CurrentBans.OrderBy(x => x)) { <span class="badge border border-danger text-danger">@ban</span> }
                </div>
                @if(IsHost /*&& hasRerolled == false*/) { <button class="btn btn-sm btn-outline-warning w-25 mx-auto" @onclick="RerollBans" >🔄 REROLL</button> }
            </div>
            }
        </div>

        @* --- Character Select By Team --- *@
        <div class="row g-4">
            <div class="col-md-6">
                <h2 class="text-info border-bottom pb-2">TEAM 1</h2>
                @foreach(Player player in matchSession.Team1) {
                <div class="card bg-dark mb-2 @(activePicker == player ? "border-info border-3 shadow-glow-info" : "border-secondary")">
                    <div class="card-body p-2">
                        <span class="badge bg-info text-dark fw-bold fs-6 mb-2">@player.Name @(player.Name == myIdentity ? "(YOU)" : "")</span>
                        <div class="d-flex flex-wrap gap-1 mt-1">
                            @foreach (Character character in player.Roster)
                            {
                                <span class="badge bg-info text-dark">@character.Name</span>
                            }
                            @for (int i = player.Roster.Count; i < 5; i++)
                            {
                                <span class="badge border border-secondary text-secondary opacity-50">Empty</span>
                            }
                        </div>
                    </div>
                </div>
                }
            </div>
            <div class="col-md-6 text-end">
                <h2 class="text-danger border-bottom pb-2">TEAM 2</h2>
                @foreach(Player player in matchSession.Team2) {
                <div class="card bg-dark mb-2 @(activePicker == player ? "border-danger border-3 shadow-glow-danger" : "border-secondary")">
                    <div class="card-body p-2">
                        <span class="badge bg-danger text-white fw-bold fs-6 mb-2">@(player.Name == myIdentity ? "(YOU) " : "")@player.Name</span>
                        <div class="d-flex flex-wrap gap-1 justify-content-end mt-1">
                            @foreach (Character character in player.Roster)
                            {
                                <span class="badge bg-danger">@character.Name</span>
                            }
                            
                            @for (int i = player.Roster.Count; i < 5; i++)
                            {
                                <span class="badge border border-secondary text-secondary opacity-50">Empty</span>
                            }
                        </div>
                    </div>
                </div>
                }
            </div>
        </div>

        
        // Search Bar For Characters
        <div class="mt-4 p-4 bg-dark rounded border border-secondary shadow">
            <div class="row g-2 mb-3">
                <div class="col-md-4">
                    <select class="form-select bg-secondary text-white border-0" @bind="selectedSeries">
                        <option value="">All Series</option>
                        @foreach (string series in CharacterData.MasterList.Select(c => c.Series).Distinct().OrderBy(s => s)) {
                            <option value="@series">@series</option>
                        }
                    </select>
                    <select class="form-select bg-secondary text-white border-0" @bind="selectedTier">
                        <option value="">All Tiers</option>
                        @foreach (CharacterTier tier in CharacterData.MasterList.Select(character => character.Tier).Distinct().OrderBy(t => t)) {
                            <option value="@tier">@tier</option>
                        }
                    </select>
                </div>
                <div class="col-md-8">
                    <input @bind="searchQuery" @bind:event="oninput" class="form-control bg-white text-black border-secondary" placeholder="Search characters..." />
                </div>
            </div>

            
            
            @*--- The Character Buttons That You Click To Select A Character ---*@
            <div class="d-flex flex-wrap gap-2 justify-content-center overflow-auto" style="max-height: 400px;">
                @foreach (Character charItem in GetFilteredCharacters()) {
                    bool isBanned = matchSession.CurrentBans.Contains(charItem.Name, StringComparer.OrdinalIgnoreCase);
                    bool taken = matchSession.PickingOrder.Any(p => p.Roster.Any(c => c.Name == charItem.Name));
                    
                    // Button Style
                    string btnTierStyle = "btn-outline-primary";
                    if (!isBanned && !taken)
                    {
                        if (charItem.Tier == CharacterTier.Z) btnTierStyle = "btn-z-tier";
                        else if (charItem.Tier == CharacterTier.S) btnTierStyle = "btn-s-tier";
                    }

                    <button class="btn btn-sm @(isBanned ? "btn-outline-danger disabled" : (taken ? "btn-secondary disabled opacity-25" : btnTierStyle))"
                            style="min-width: 140px; transition: all 0.2s ease;" @onclick="() => SelectCharacter(charItem)" disabled="@(taken || isBanned || !isMyTurn)">
                        <div class="fw-bold text-white tier-text-glow">@charItem.Name</div>
                        <small class="text-white-50 tier-text-glow">@charItem.Series</small>
                    </button>
                }
            </div>
        </div>
        }
        
        @*--- Live Match Tracking (Basically When You See What Characters You And Your Opponent Have And You Kill Them To Win) ---*@
        else if (matchSession.Stage == MatchStage.Game) {
        @if (!string.IsNullOrEmpty(matchSession.RivalryText)) {
        <div class="text-center mb-3">
            <div class="badge bg-danger p-2 px-4 shadow-sm border border-warning rivalry-pulse">
            <span class="text-warning fw-bold animate-bounce">🔥 RIVALRY MATCH:</span> @matchSession.RivalryText
            </div>
        </div>
        }

        <div class="text-center mb-4">
            <h2 class="display-5 fw-bold text-warning">MATCH TRACKER</h2>
        </div>

        <div class="row g-4">
            <div class="col-md-6">
                
                @*--- Team 1 Info ---*@
                <h2 class="text-info border-bottom pb-2">TEAM 1</h2>
                @foreach (Player player in matchSession.Team1)
                {
                    <div class="card bg-dark mb-3 @(player.Roster.All(character => character.IsLost) ? "opacity-50 grayscale shadow-none" : "border-info shadow-sm")">
                        <div class="card-body">
                            <h5 class="text-light mb-3">@player.Name</h5>
                            <div class="d-flex flex-wrap gap-2">
                                @foreach (var character in player.Roster)
                                {
                                    <button class="btn @(character.IsLost ? "btn-info" : "btn-outline-info")"
                                            @onclick="async () => { character.IsLost = true; await CheckVictory(); matchSession.Notify(); }"
                                            disabled="@character.IsLost">
                                        @(character.IsLost ? "💀" : "") @character.Name
                                    </button>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
            <div class="col-md-6 text-end">
                
                @*--- Team 2 Info ---*@
                <h2 class="text-danger border-bottom pb-2">TEAM 2</h2>
                @foreach (Player player in matchSession.Team2)
                {
                    <div class="card bg-dark mb-3 @(player.Roster.All(character => character.IsLost) ? "opacity-50 grayscale shadow-none" : "border-danger shadow-sm")">
                        <div class="card-body">
                            <h5 class="text-light mb-3">@player.Name</h5>
                            <div class="d-flex flex-wrap gap-2 justify-content-end">
                                @foreach (var character in player.Roster)
                                {
                                    <button class="btn @(character.IsLost ? "btn-danger" : "btn-outline-danger")"
                                            @onclick="async () => { character.IsLost = true; await CheckVictory(); matchSession.Notify(); }"
                                            disabled="@character.IsLost">
                                        @(character.IsLost ? "💀" : "") @character.Name
                                    </button>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>

        @*--- Win Display ---*@
        @if (matchSession.WinningTeamNumber != 0) {
            <div class="modal-backdrop fade show" style="background-color: rgba(0,0,0,0.85); z-index: 1050;"></div>
            <div class="position-fixed top-50 start-50 translate-middle w-100 text-center" style="z-index: 1060;">
                <div class="reveal-card">
                    <h1 class="display-1 animate-bounce">🏆</h1>
                    <h1 class="display-2 fw-bold text-warning" style="text-shadow: 0 0 20px rgba(255,193,7,0.5);">
                        TEAM @matchSession.WinningTeamNumber WINS
                    </h1>
            
                    <div class="mt-4">
                        @if (!matchSession.HistoryRecorded) {
                            <div class="spinner-border text-info mb-2" role="status"></div>
                            <div class="text-info fw-bold animate-pulse">AUTOSAVING MATCH DATA...</div>
                        } else {
                            <button class="btn btn-lg btn-warning px-5 fw-bold shadow-lg ms-3" @onclick='ResetGame'>
                                RETURN TO MAIN MENU
                            </button>
                            <div class="text-muted mt-2 small">✅ Match history updated.</div>
                        }
                    </div>
                    @if(!string.IsNullOrEmpty(errorMessage)) { <div class="text-danger mt-3">@errorMessage</div> }
                </div>
            </div>
        }
        }
    </div>

    @code {
        
        // Setup Info
    private GameSession? matchSession;
    
    // String Declarations
    private string 
        joinCode = "", 
        myIdentity = "", // Player/User Identifier
        errorMessage = "", // Messages Used To Display Why The Player Can't Do Something (EX: Player Tries To Pick 2 Z Tiers And It Says No)
        searchQuery = "", // What You're Searching
        selectedSeries = "", // The Series The Player Just Selected
        selectedTier = "", // The Tier The Player Just Selected
        randomNameDisplay = "", // Used In The Animation To Randomize Teams
        browserId = Guid.NewGuid().ToString(), 
        temporaryName = "";
    
    // Integer Declarations
    private int 
        playersPerTeam = 2, 
        charIdCounter = 1;

    // Boolean Declarations
    private bool
        isSpinning,
        showBans,
        hasRerolled = false;
        
    private bool IsHost => matchSession?.HostId == browserId;
    
    // Perma Bans
    private readonly List<string> staticBans = [
        "Denji", "Achilles", "Mr President", "Iskandar", "Shirou", "Yuji", "Soulja Boy", "Ragna", "Guts", "Baam"
    ];
    
    // Rotating bans
    private readonly List<string> RotatingPool =
    [
        "Kazuma", "Misaka", "Usopp", "Crocodile", "Enel", "Jiren", "Kira", "Hol Horse", "Ishtar", "Meruem",
        "Morel", "Madara", "PTS Luffy", "TS Luffy", "TS Zoro", "TS Sanji", "Kizaru", "Akainu", "Arlong", "Namek Goku",
        "Android Vegeta", "Piccolo", "Krillin", "Buu Goku", "Trunks", "Caulifla", "Majin Vegeta", "Vegito", "Frieza",
        "Pui Pui", "Perfect Cell", "Super Goku", "Super Vegeta", "Gogeta", "Bardock", "Broly", 
        "Kakashi", "Zabuza", "Gaara", "Itachi", "Pain", "Guy", "PTS Ichigo", "Rukia", "Grimmjow",
        "Starrk", "Toshiro", "Ulquiorra", "TS Ichigo", "Yoruichi", "Kenpachi", "Aizen", "Yhwach", "Yamamoto", "Rikka", "Afro",
        "Chika", "Ryuko", "Guts", "Asta", "Hiei", "Yusuke", "Accelerator", "Akira", "Alucard", "Edward", "Jotaro",
        "Giorno", "Ghiacchio", "Risotto", "Kars", "Dio", "Doppio", "Gon", "Kurapika", "Uvogin", "Sukuna",
        "Choso", "Nanami", "Jogo", "All Might", "Endeavor", "Saber", "Gilgamesh", "Kiritsugu", "Lancer", "Mash", "Illya", "Pucci",
        "Gray", "Natsu", "Aki", "Power", "Rengoku", "Kokushibo", "Tanjiro", "Sinon", "Asuna", "Saitama", "Raiden", "Snake", "Ricardo", 
        "Roland", "Wano Law", "Gojo", "2B", "Shadow Dummy", "Netero", "Metal Bat", "PTS Zoro", "Todo", "All Might", "Satsuki", 
        "Jonathan", "Kenpachi"
    ];

    private async Task CreateNewRoom() {
        
        @*--- Creating The Room And Checking If It Is Connected To The Database ---*@
        try {
            StateHasChanged();
            matchSession = SessionService.Create();
            matchSession.HostId = browserId;
            matchSession.OnChange += Refresh;
           
            try {
                await using var db = await DbFactory.CreateDbContextAsync();
            }
            catch (Exception dbEx) {
                Console.WriteLine($"Database History Load Failed: {dbEx.Message}");
                errorMessage = "Note: Global History unavailable (Database Connection Error).";
            }

            UpdateUnassignedList();
            matchSession.Notify();
        }
        catch (Exception ex) {
            errorMessage = "Critical Error: " + ex.Message;
            errorMessage = $"CRASH: {ex.Message}";
            matchSession?.Notify();
        }
    }

    private async Task JoinRoom() {
        if (SessionService.Sessions.TryGetValue(joinCode.ToUpper(), out GameSession? ex)) { 
            matchSession = ex; 
            matchSession.OnChange += Refresh; 
            errorMessage = "";

            await using var db = await DbFactory.CreateDbContextAsync();
        
           // Makes Sure Player That Joined Can See Current Slots
            matchSession.Notify(); 
        }
        else { errorMessage = "Invalid Room Code."; }
    }
    
    private void Refresh() 
    {
        InvokeAsync(() => {
            if (matchSession != null)
            {
                Player? user = matchSession.PickingOrder.FirstOrDefault(p => p.ClaimedBySessionId == browserId) 
                         ?? matchSession.UnassignedPlayers.FirstOrDefault(p => p.ClaimedBySessionId == browserId);
                
                if (user != null) 
                {
                    myIdentity = user.Name;
                }
            }
            StateHasChanged();
        });
    }
    
    // Updates The Player Count (If You Press 2v2 Or 3v3)
    private void OnPlayerCountChange(ChangeEventArgs e) { if (int.TryParse(e.Value?.ToString(), out int val)) { playersPerTeam = val; UpdateUnassignedList(); } }

    private void UpdateUnassignedList() {
    if (matchSession == null) return;
    matchSession.UnassignedPlayers.Clear();
    for (int i = 0; i < (playersPerTeam * 2); i++) { matchSession.UnassignedPlayers.Add(new Player()); }
    matchSession.Notify();
    }
    
    // Automatic Task To Check For Page Refreshes
    protected override Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && matchSession != null)
        {
            // If The User Refreshes The Page Find Which Player Their Browser ID Belonged To
            var myClaimedPlayer = matchSession.UnassignedPlayers.Concat(matchSession.PickingOrder).FirstOrDefault(x => x.ClaimedBySessionId == browserId);
            if (myClaimedPlayer != null)
            {
                myIdentity = myClaimedPlayer.Name;
                StateHasChanged();
            }
        }

        return Task.CompletedTask;
    }
    private async Task WheelSpinTeams() {
        if (matchSession == null || !IsHost) return;

        // Check If All Players Have Filled Out Names First
        if (matchSession.UnassignedPlayers.Any(player => string.IsNullOrWhiteSpace(player.Name))) { 
            errorMessage = "Fill all player names first."; 
            return; 
        }
        if (matchSession.UnassignedPlayers.Any(p => string.IsNullOrWhiteSpace(p.ClaimedBySessionId))) {
            errorMessage = "Everyone must CLAIM a slot before starting!";
            return;
        }
        if (matchSession.UnassignedPlayers.Any(p => !p.IsLocked)) { 
            errorMessage = "Everyone must LOCK their names before starting!"; 
            return; 
        }
        isSpinning = true; 
        errorMessage = "";
        var rng = new Random();

        for (int i = 0; i < 30; i++) {
            randomNameDisplay = matchSession.UnassignedPlayers[rng.Next(matchSession.UnassignedPlayers.Count)].Name;
            matchSession.Notify(); 
            await Task.Delay(50);
        }
        
        // Randomizes Players And Puts Them In A New List
        List<Player> shuffled = matchSession.UnassignedPlayers.OrderBy(_ => rng.Next()).ToList();
        matchSession.Team1 = shuffled.Take(playersPerTeam).ToList();
        matchSession.Team2 = shuffled.Skip(playersPerTeam).ToList();

        
        matchSession.PickingOrder.Clear();
        for(int i = 0; i < playersPerTeam; i++) { 
            matchSession.PickingOrder.Add(matchSession.Team1[i]); 
            matchSession.PickingOrder.Add(matchSession.Team2[i]); 
        }

        foreach(var player in matchSession.PickingOrder) { 
            player.Roster.Clear(); 
            player.TeamNumber = matchSession.Team1.Contains(player) ? 1 : 2; 
        }

        GenerateBans();
        isSpinning = false; 
        matchSession.Stage = MatchStage.CharacterSelect; 

        matchSession.Notify(); 
    }

    
    private void SelectCharacter(Character chosen) {
        
        if (matchSession == null) return;
        var player = matchSession.PickingOrder[matchSession.CurrentPickerIndex];
        errorMessage = "";
     
        
        if (player.ClaimedBySessionId != browserId) return; 

        if (player.GetSeriesCount(chosen.Series) >= 2) {
            errorMessage = "You Cannot Pick More Than 2 Characters From The Same Series!";
            matchSession.Notify();
            return;
        }
        
        int currentSTiers = player.GetSTiers();
        int currentZTiers = player.GetZTier();
        
        
        bool choosingTakeOver = chosen.Tier == CharacterTier.TakeOver;
        bool choosingZTier = chosen.Tier == CharacterTier.Z;
        bool choosingSTier = chosen.Tier == CharacterTier.S;

        var myTeam = player.TeamNumber == 1 ? matchSession.Team1 : matchSession.Team2;
        bool teamHasZ = myTeam.Any(p => p.Roster.Any(c => c.Tier == CharacterTier.Z));
        bool teamHasTakeOver = myTeam.Any(p => p.Roster.Any(c => c.Tier == CharacterTier.TakeOver));
        // Z tier per player
        if (currentZTiers == 1 && choosingZTier)
        {
            errorMessage = "You Cannot Pick More Than 1 Z-Tier Character!";
            matchSession.Notify();
            return;
        }
        
        
        if (teamHasZ && choosingTakeOver)
        {
            errorMessage = "You Cannot Pick A Take Over Character With A Z-Tier On Your Team!";
            matchSession.Notify();
            return;
        }

        if (teamHasTakeOver && choosingTakeOver)
        {
            errorMessage = "You Cannot Pick A Take Over Character With A Take Over On Your Team!";
            matchSession.Notify();
            return; 
        }
        
        if (currentSTiers >= 2 && choosingSTier){
            errorMessage = "You Cannot Pick More Than 2 S-Tier Characters!";
            matchSession.Notify();
            return;
        }
        
  
        
        player.Roster.Add(new Character(chosen.Name, chosen.Series, charIdCounter++, chosen.Tier));
        matchSession.CurrentPickerIndex = (matchSession.CurrentPickerIndex + 1) % matchSession.PickingOrder.Count;
        
        if (matchSession.PickingOrder.All(x => x.Roster.Count == 5)) { 
            CheckForRivalry(); 
            matchSession.Stage = MatchStage.Game; 
        }
        matchSession.Notify();
    }
    
    private async Task RecordMatchResult() {
        if (matchSession == null || matchSession.HistoryRecorded) return;

        matchSession.HistoryRecorded = true;

        try {
            int t1TotalLost = matchSession.Team1.Sum(p => p.Roster.Count(c => c.IsLost));
            int t2TotalLost = matchSession.Team2.Sum(p => p.Roster.Count(c => c.IsLost));

            var result = new MatchResult {
                Team1Key = GetTeamKey(matchSession.Team1),
                Team2Key = GetTeamKey(matchSession.Team2),
                Team1Names = matchSession.Team1.Select(p => p.Name).ToList(),
                Team2Names = matchSession.Team2.Select(p => p.Name).ToList(),
                Team1Roster = matchSession.Team1.SelectMany(p => p.Roster.Select(c => c.Name)).ToList(),
                Team2Roster = matchSession.Team2.SelectMany(p => p.Roster.Select(c => c.Name)).ToList(),
                BanList = new List<string>(matchSession.CurrentBans),
            
                Team1Rounds = matchSession.Team2.Count > 0 ? (t2TotalLost / matchSession.Team2.Count) : 0,
                Team2Rounds = matchSession.Team1.Count > 0 ? (t1TotalLost / matchSession.Team1.Count) : 0,
            
                WinningTeamSide = matchSession.WinningTeamNumber,
                MatchDate = DateTime.UtcNow
            };

            await using (var db = await DbFactory.CreateDbContextAsync())
            {
                db.Matches.Add(result);
                await db.SaveChangesAsync();
            }
    
            errorMessage = "";
            matchSession.Notify();
        }
        catch (Exception ex) {
            matchSession.HistoryRecorded = false; 
            var innerMsg = ex.InnerException?.Message ?? ex.Message;
            errorMessage = $"Autosave Failed: {innerMsg}";
            matchSession.Notify();
        }
    }
    
    
    private async Task CheckVictory() {
        if (matchSession == null) return;

        if (matchSession.Team1.All(player => player.Roster.All(c => c.IsLost))) 
        {
            matchSession.WinningTeamNumber = 2;
        }
        else if (matchSession.Team2.All(player => player.Roster.All(c => c.IsLost))) 
        {
            matchSession.WinningTeamNumber = 1;
        }

        if (matchSession.WinningTeamNumber != 0 && !matchSession.HistoryRecorded) 
        {
            await RecordMatchResult();
        }
    }

    private void ResetGame() { if(matchSession!=null) { matchSession.Stage = MatchStage.Home; matchSession.WinningTeamNumber = 0; matchSession.HistoryRecorded = false; matchSession.Notify(); } }

    private void GenerateBans() {
    if (matchSession == null) return;
    var rng = new Random();
    matchSession.CurrentBans = new List<string>(staticBans);
    int banCount = 50;
    matchSession.CurrentBans.AddRange(RotatingPool.OrderBy(_ => rng.Next()).Take(banCount));
    matchSession.Notify();
    }

    private void RerollBans()
    {
        //hasRerolled = true;
        GenerateBans();
    }
    private string GetTeamKey(List<Player> team) => string.Join(", ", team.Select(p => p.Name).OrderBy(n => n));

    
    private void CheckForRivalry() {
    if (matchSession == null) return;
    string t1K = GetTeamKey(matchSession.Team1), t2K = GetTeamKey(matchSession.Team2);
    var h2H = matchSession.MatchHistory.Where(m => (m.Team1Key == t1K && m.Team2Key == t2K) || (m.Team1Key == t2K && m.Team2Key == t1K)).ToList();
    if (h2H.Any()) {
    int t1W = h2H.Count(m => (m.Team1Key == t1K && m.WinningTeamSide == 1) || (m.Team2Key == t1K && m.WinningTeamSide == 2));
    matchSession.RivalryText = $"{t1W} - {h2H.Count - t1W}";
    }
    }

    private IEnumerable<Character> GetFilteredCharacters() {
    var searchedChar = CharacterData.MasterList.AsEnumerable();
    if (!string.IsNullOrEmpty(selectedSeries)) searchedChar = searchedChar.Where(c => c.Series == selectedSeries);
    if (!string.IsNullOrWhiteSpace(searchQuery)) searchedChar = searchedChar.Where(c => c.Name.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) || c.Series.Contains(searchQuery, StringComparison.OrdinalIgnoreCase));
    if (!string.IsNullOrWhiteSpace(selectedTier))
    {
        if (Enum.TryParse<CharacterTier>(selectedTier, out var parsedTier))
        {
            searchedChar = searchedChar.Where(c => c.Tier == parsedTier);
        }
    }
    
    // The amount of characters that appear in the menu
    return searchedChar.Take(200);
    }

    private void InitializeSetup() { if (matchSession != null) { GenerateBans(); matchSession.Stage = MatchStage.Setup; UpdateUnassignedList(); matchSession.Notify(); } }
    public void Dispose() { if (matchSession != null) matchSession.OnChange -= Refresh; }
    
    
    private void ClaimSlot(Player player) {
        player.ClaimedBySessionId = browserId;
        temporaryName = ""; // Clear buffer for new entry
        matchSession?.Notify();
    }

    private void LockMyName(Player player) {
        if (string.IsNullOrWhiteSpace(temporaryName)) return;
    
        player.Name = temporaryName;
        player.IsLocked = true;
        myIdentity = player.Name; // Sync global identity
        matchSession?.Notify();
    }

    private void UnlockName(Player player) {
        player.IsLocked = false;
        temporaryName = player.Name; // Bring the name back to the buffer
        matchSession?.Notify();
    }
    }

