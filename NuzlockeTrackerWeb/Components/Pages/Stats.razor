@page "/Stats"
@rendermode InteractiveServer
@using NuzlockeTrackerWeb.Data
@using Microsoft.EntityFrameworkCore
@using NuzlockeTrackerWeb.Components.GameData
@inject IDbContextFactory<AppDbContext> DbFactory
//@inject NavigationManager NavManager


 <div class="container py-4">
    @* The HTML UI checks our renamed variables to decide what layout to show *@
    @if (_activeDetailedMatch != null)
    
    {
        <div class="card bg-dark text-light border-secondary p-4">
            <button class="btn btn-outline-secondary mb-3" @onclick="() => _activeDetailedMatch = null"> ← Back to Match History </button>
            <div class="row align-items-center">
            <h3>Match Details</h3>
            <p class="mb-1 text-white-50">Date Played:</p>
            <p class="text-warning fw-bold">@_activeDetailedMatch.MatchDate.ToString("yyyy-mm-dd")</p>
            <div class="col-5">
                        @foreach(var name in _activeDetailedMatch.Team1Names) {
                            <h3 class="badge bg-info text-dark fs-4 m-1">@name</h3>
                        }
                    </div>
                    <div class="col-2">
                        <div class="display-3 fw-bold text-warning" style="text-shadow: 0 0 15px rgba(255,193,7,0.4);">
                            @_activeDetailedMatch.Team1Rounds - @_activeDetailedMatch.Team2Rounds
                        </div>
                    </div>
                    <div class="col-5">
                        @foreach(var name in _activeDetailedMatch.Team2Names) {
                            <h3 class="badge bg-danger text-white fs-4 m-1">@name</h3>
                        }
                    </div>
                </div>
            </div>
        <div class="card-body bg-black p-4">
            <div class="row">
                <div class="col-6 border-end border-secondary">
                    <h6 class="text-info mb-3">ROSTER</h6>
                    <div class="d-flex flex-wrap gap-2">
                        @foreach(var c in _activeDetailedMatch.Team1Roster){ <span class="badge border border-info text-info">@c</span> }
                    </div>
                </div>
                <div class="col-6 text-end">
                    <h6 class="text-danger mb-3">ROSTER</h6>
                    <div class="d-flex flex-wrap gap-2 justify-content-end">
                        @foreach(var c in _activeDetailedMatch.Team2Roster){ <span class="badge border border-danger text-danger">@c</span> }
                    </div>
                </div>
            </div>
        </div>
    }
    
    else
    {
        <div class="text-center mb-4">
            <h2 class="text-black fw-bold">MATCH HISTORY</h2>
            <p class="text-black-50 fw-bold">Player And Team Match Data</p>
        </div>
        <div class="row g-4">
            <div class="col-md-8">
                <div class="card bg-dark border-info text-light shadow h-100">
                    <div class="card-header border-info bg-black d-flex justify-content-between align-items-center p-0">
                        <div class="btn-group w-100">
                            <button class="btn @(_currentStatsCategory == "players" ? "btn-info" : "btn-dark")" 
                                    @onclick='() => _currentStatsCategory = "players"'>👤 Players</button>
                            <button class="btn @(_currentStatsCategory == "teams" ? "btn-info" : "btn-dark")" 
                                    @onclick='() => _currentStatsCategory = "teams"'>👥 Teams</button>
                            <button class="btn @(_currentStatsCategory == "characters" ? "btn-info" : "btn-dark")" 
                                    @onclick='() => _currentStatsCategory = "characters"'>👥 Characters</button>
                        </div>
                    </div>

                    <div class="card-body p-0">
                        @if (_currentStatsCategory == "players") {
                            <table class="table table-dark table-hover mb-0 text-center reveal-card">
                                <thead><tr><th>Player</th><th>W - L</th><th>Streak</th><th>Ratio</th></tr></thead>
                                <tbody>
                                @foreach (var stat in _playerRankings) {
                                    <tr>
                                        <td class="fw-bold">@stat.PlayerName</td>
                                        <td><span class="text-info">@stat.Wins</span> - <span class="text-danger">@stat.Losses</span></td>
                                        <td>
                                            @if (stat.CurrentStreak >= 3) { <span class="badge bg-danger text-warning rivalry-pulse">🔥 @stat.CurrentStreak</span> }
                                            else { <span class="text-white">@stat.CurrentStreak</span> }
                                        </td>
                                        <td class="fw-bold text-info">@stat.Ratio%</td>
                                    </tr>
                                }
                                </tbody>
                            </table>
                        } else {
                            <table class="table table-dark table-hover mb-0 text-center reveal-card">
                                <thead><tr><th>Squad Composition</th><th>Wins</th><th>Losses</th><th>Win Rate</th></tr></thead>
                                <tbody>
                                @foreach (var team in _teamRecords) {
                                    <tr>
                                        <td class="fw-bold text-warning">@team.TeamComposition</td>
                                        <td class="text-info">@team.Wins</td><td class="text-danger">@team.Losses</td><td class="text-info">@team.Ratio%</td>
                                    </tr>
                                }
                                </tbody>
                            </table>
                        } else {
                        @* --- NEW CHARACTER WIN RATE TABLE --- *@
                        <table class="table table-dark table-hover mb-0 text-center reveal-card">
                            <thead><tr><th>Character Name</th><th>Wins</th><th>Losses</th><th>Win Rate</th></tr></thead>
                            <tbody>
                            @foreach (var hero in _characterRecords) {
                                <tr>
                                    <td class="fw-bold text-white">@hero.CharacterName</td>
                                    <td class="text-info">@hero.Wins</td>
                                    <td class="text-danger">@hero.Losses</td>
                                    <td class="fw-bold text-warning">@hero.Ratio%</td>
                                </tr>
                            }
                            </tbody>
                        </table>
                        }
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card bg-dark border-info text-light shadow mb-4">
                    <div class="card-header border-warning bg-black text-warning"><h5>Top 3 Squads</h5></div>
                    <div class="card-body p-0">
                        <table class="table table-dark table-sm mb-0">
                            <tbody>
                            @foreach (var team in _teamRecords.Take(3)) {
                                <tr><td class="ps-3 py-2 small">@team.TeamComposition</td><td class="text-end pe-3 text-warning">@team.Wins-@team.Losses</td></tr>
                            }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <div class="col-12">
                <div class="card bg-dark border-secondary text-light shadow">
                    <div class="card-header bg-black"><h5>Full Match History</h5></div>
                    <div class="card-body p-0">
                        <div class="list-group list-group-flush">
                            @for (int i = _historicalMatches.Count - 1; i >= 0; i--) {
                                var match = _historicalMatches[i];
                                //var idx = i;
                                <button class="list-group-item list-group-item-action bg-dark text-light border-secondary p-3"@onclick="() => _activeDetailedMatch = match">
        <div class="row align-items-center">
            <div class="col-4">
                @foreach (var name in match.Team1Names)
                {
                    <span class="badge @(match.WinningTeamSide == 1 ? "bg-info text-dark" : "border border-info text-info") me-1">@name</span>
                }
            </div>
            <div class="col-4 text-center">
                <span class="h3 fw-bold text-warning mb-0" style="text-shadow: 0 0 10px rgba(255,193,7,0.3);">
                    @match.Team1Rounds - @match.Team2Rounds
                </span>
            </div>
            <div class="col-4 text-end">
                @foreach (var name in match.Team2Names)
                {
                    <span class="badge @(match.WinningTeamSide == 2 ? "bg-danger text-white" : "border border-danger text-danger") ms-1">@name</span>
                }
            </div>
        </div>
    </button>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
        
    }
    
@code {
    private List<MatchResult> _historicalMatches = new();
    private MatchResult? _activeDetailedMatch = null;
    private string _currentStatsCategory = "players"; // Replaces "statsTab"
    
    private List<PlayerLeaderboardEntry> _playerRankings = new();
    private List<TeamCompositionRecord> _teamRecords = new();
    private List<CharacterWinRateRecord> _characterRecords = new();

    protected override async Task OnInitializedAsync()
    {
        using var db = await DbFactory.CreateDbContextAsync();
        
        var matchesFromDatabase = await db.Matches
            .OrderByDescending(m => m.Id)
            .Take(50) 
            .ToListAsync();

        _historicalMatches = matchesFromDatabase;
        _playerRankings = RunPlayerMathEngine(_historicalMatches);
        _teamRecords = RunTeamMathEngine(_historicalMatches);
        _characterRecords = RunCharacterMathEngine(_historicalMatches); 
    }

    // --- Cleaned up logic loops from your old page ---
    private List<PlayerLeaderboardEntry> RunPlayerMathEngine(List<MatchResult> history)
    {
        // 1. Temporary dictionary to track players as we loop through matches
        var playerMap = new Dictionary<string, PlayerLeaderboardEntry>(StringComparer.OrdinalIgnoreCase);

        // 2. Process matches from oldest to newest (helpful if you calculate consecutive streaks later)
        foreach (var match in history.AsEnumerable().Reverse())
        {
            // Safe check: skip processing if names lists are null
            if (match.Team1Names == null || match.Team2Names == null) continue;

            // Process every player on Team 1
            foreach (var name in match.Team1Names)
            {
                if (!playerMap.TryGetValue(name, out var entry))
                {
                    entry = new PlayerLeaderboardEntry { PlayerName = name };
                    playerMap[name] = entry;
                }

                if (match.WinningTeamSide == 1)
                {
                    entry.Wins++;
                    entry.CurrentStreak++;
                }
                else
                {
                    entry.Losses++;
                    entry.CurrentStreak = 0; // Streak broken
                }
            }

            // Process every player on Team 2
            foreach (var name in match.Team2Names)
            {
                if (!playerMap.TryGetValue(name, out var entry))
                {
                    entry = new PlayerLeaderboardEntry { PlayerName = name };
                    playerMap[name] = entry;
                }

                if (match.WinningTeamSide == 2)
                {
                    entry.Wins++;
                    entry.CurrentStreak++;
                }
                else
                {
                    entry.Losses++;
                    entry.CurrentStreak = 0; // Streak broken
                }
            }
        }

        // 3. Return the results ordered by total wins descending
        return playerMap.Values
            .OrderByDescending(p => p.Wins)
            .ThenByDescending(p => p.Ratio)
            .ToList();
    }

    private List<TeamCompositionRecord> RunTeamMathEngine(List<MatchResult> history)
    {
        var teamMap = new Dictionary<string, TeamCompositionRecord>(StringComparer.OrdinalIgnoreCase);

        foreach (var match in history)
        {
            if (match.Team1Names == null || match.Team2Names == null || match.Team1Names.Count == 0 || match.Team2Names.Count == 0) 
                continue;

            // Sort names alphabetically so "Alex & Bob" and "Bob & Alex" count as the same squad
            string team1Key = string.Join(" & ", match.Team1Names.OrderBy(n => n));
            string team2Key = string.Join(" & ", match.Team2Names.OrderBy(n => n));

            // Process Team 1
            if (!teamMap.TryGetValue(team1Key, out var t1Entry))
            {
                t1Entry = new TeamCompositionRecord { TeamComposition = team1Key };
                teamMap[team1Key] = t1Entry;
            }
            if (match.WinningTeamSide == 1) t1Entry.Wins++;
            else t1Entry.Losses++;

            // Process Team 2
            if (!teamMap.TryGetValue(team2Key, out var t2Entry))
            {
                t2Entry = new TeamCompositionRecord { TeamComposition = team2Key };
                teamMap[team2Key] = t2Entry;
            }
            if (match.WinningTeamSide == 2) t2Entry.Wins++;
            else t2Entry.Losses++;
        }

        return teamMap.Values
            .OrderByDescending(t => t.Wins)
            .ThenByDescending(t => t.Ratio)
            .ToList();
    }

    // --- Clean, Readable Data Transfer Objects (DTOs) ---
    public class PlayerLeaderboardEntry
    {
        public string PlayerName { get; set; } = "";
        public int Wins { get; set; }
        public int Losses { get; set; }
        public int CurrentStreak { get; set; }
        public int Ratio => Wins + Losses == 0 ? 0 : (Wins * 100) / (Wins + Losses);
    }

    public class TeamCompositionRecord
    {
        public string TeamComposition { get; set; } = "";
        public int Wins { get; set; }
        public int Losses { get; set; }
        public int Ratio => Wins + Losses == 0 ? 0 : (Wins * 100) / (Wins + Losses);
    }
    
    private List<CharacterWinRateRecord> RunCharacterMathEngine(List<MatchResult> history)
    {
        var charMap = new Dictionary<string, CharacterWinRateRecord>(StringComparer.OrdinalIgnoreCase);

        foreach (var match in history)
        {
            // Guard check against empty arrays or null records
            if (match.Team1Roster == null || match.Team2Roster == null) continue;

            // 1. Process Team 1 Characters
            foreach (var character in match.Team1Roster)
            {
                if (string.IsNullOrWhiteSpace(character)) continue;

                if (!charMap.TryGetValue(character, out var record))
                {
                    record = new CharacterWinRateRecord { CharacterName = character };
                    charMap[character] = record;
                }

                if (match.WinningTeamSide == 1) record.Wins++;
                else record.Losses++;
            }

            // 2. Process Team 2 Characters
            foreach (var character in match.Team2Roster)
            {
                if (string.IsNullOrWhiteSpace(character)) continue;

                if (!charMap.TryGetValue(character, out var record))
                {
                    record = new CharacterWinRateRecord { CharacterName = character };
                    charMap[character] = record;
                }

                if (match.WinningTeamSide == 2) record.Wins++;
                else record.Losses++;
            }
        }

        // Sort by highest overall Win Rate, then total Wins for tie-breakers
        return charMap.Values
            .OrderByDescending(c => c.Ratio)
            .ThenByDescending(c => c.Wins)
            .ToList();
    }

// DTO Class representation for clean rendering
    public class CharacterWinRateRecord
    {
        public string CharacterName { get; set; } = "";
        public int Wins { get; set; }
        public int Losses { get; set; }
        public int Ratio => Wins + Losses == 0 ? 0 : (Wins * 100) / (Wins + Losses);
    }
 }
</div>