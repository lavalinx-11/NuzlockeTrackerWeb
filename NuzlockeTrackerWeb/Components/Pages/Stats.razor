                            <span class="text-danger text-end fw-bold" style="font-size:0.75rem;">@t.Wins W - @t.Losses L (@t.Ratio%)</span>
                        </div>
                    }
                }
            }
            else
            {
                <div class="text-muted small text-center">No teams recorded.</div>
            }
        </div>
    </div>
</div>
        </div>    


                <div class="col-md-6">
                    <div class="card bg-black border-secondary">
