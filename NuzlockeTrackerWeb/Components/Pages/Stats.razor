@page "/Stats"
@rendermode InteractiveServer
@using NuzlockeTrackerWeb.Data
@using Microsoft.EntityFrameworkCore
@using NuzlockeTrackerWeb.Components.GameData
@inject IDbContextFactory<AppDbContext> DbFactory


 <div class="container py-4">
    @if (activeDetailedMatch != null)
{
    <div class="card bg-dark text-light border-secondary p-4">
        <button class="btn btn-outline-secondary mb-3 align-self-start" @onclick="() => activeDetailedMatch = null"> ← Back to Match History </button>
        
        <div class="row align-items-center text-center mb-3">
            <h3>Match Details</h3>
            <p class="mb-1 text-white-50">Date Played:</p>
            <p class="text-warning fw-bold">@activeDetailedMatch.MatchDate.ToString("yyyy-MM-dd")</p>
            
            <div class="col-5">
                @foreach(var name in activeDetailedMatch.Team1Names) {
                    <h3 class="badge bg-info text-dark fs-4 m-1">@name</h3>
                }
            </div>
            <div class="col-2">
                <div class="display-3 fw-bold text-warning" style="text-shadow: 0 0 15px rgba(255,193,7,0.4);">
                    @activeDetailedMatch.Team1Rounds - @activeDetailedMatch.Team2Rounds
                </div>
            </div>
            <div class="col-5">
                @foreach(var name in activeDetailedMatch.Team2Names) {
                    <h3 class="badge bg-danger text-white fs-4 m-1">@name</h3>
                }
            </div>
        </div>

        @* --- BANNED CHARACTERS --- *@
        @if (activeDetailedMatch.BanList.Any())
        {
            <div class="border-top border-secondary pt-3 text-center">
                <h6 class="text-uppercase tracking-wider text-danger fw-bold mb-2" style="font-size: 0.85rem; letter-spacing: 1px;">
                    Banned Characters
                </h6>
                <div class="d-flex flex-wrap gap-2 justify-content-center">
                    @foreach (var bannedChar in activeDetailedMatch.BanList)
                    {
                        <span class="badge bg-black border border-danger text-danger px-3 py-2 fw-bold">
                            @bannedChar
                        </span>
                    }
                </div>
            </div>
        }
    </div>

    @* --- PLAYER CHARACTER PICKS --- *@
    <div class="card-body bg-black p-4 rounded-bottom border border-top-0 border-secondary">
        <div class="row">
           <!-- Team 1 Picks -->
<div class="col-6 border-end border-secondary">
    <h6 class="text-info mb-3 fw-bold">TEAM 1 PICKS</h6>
    <div class="d-flex flex-column gap-3">
        @for (int i = 0; i < activeDetailedMatch.Team1Names.Count; i++)
        {
            var player = activeDetailedMatch.Team1Names[i];
            
           @* --- The 5 Characters Picked By This Player --- *@
            var playerCharacters = activeDetailedMatch.Team1Roster?
                .Skip(i * 5)
                .Take(5)
                .Where(c => !string.IsNullOrWhiteSpace(c))
                .ToList() ?? new List<string>();

            <div class="bg-dark p-3 rounded border border-info-subtle">
                <div class="mb-2">
                    <span class="badge bg-info text-dark fw-bold fs-6">@player</span>
                </div>
                <div class="d-flex flex-column gap-1 ps-2 border-start border-secondary">
                    @if (playerCharacters.Any())
                    {
                        @foreach (var character in playerCharacters)
                        {
                            <div class="text-info fw-bold">• @character</div>
                        }
                    }
                    else
                    {
                        <div class="text-muted small">No characters picked</div>
                    }
                </div>
            </div>
        }
    </div>
</div>

            <!-- Team 2 Picks -->
<div class="col-6">
    <h6 class="text-danger mb-3 fw-bold text-end">TEAM 2 PICKS</h6>
    <div class="d-flex flex-column gap-3 align-items-end">
        
        @* --- The 5 Characters Picked By This Player --- *@
        @for (int i = 0; i < activeDetailedMatch.Team2Names.Count; i++)
        {
            var player = activeDetailedMatch.Team2Names[i];

            var playerCharacters = activeDetailedMatch.Team2Roster?
                .Skip(i * 5)
                .Take(5)
                .Where(c => !string.IsNullOrWhiteSpace(c))
                .ToList() ?? new List<string>();

            <div class="bg-dark p-3 rounded border border-danger-subtle w-100 text-end">
                <div class="mb-2">
                    <span class="badge bg-danger text-white fw-bold fs-6">@player</span>
                </div>
                <div class="d-flex flex-column gap-1 pe-2 border-end border-secondary align-items-end">
                    @if (playerCharacters.Any())
                    {
                        @foreach (var character in playerCharacters)
                        {
                            <div class="text-danger fw-bold">@character •</div>
                        }
                    }
                    else
                    {
                        <div class="text-muted small">No characters picked</div>
                    }
                </div>
            </div>
        }
    </div>
</div>
        </div>
    </div>
}
    
    else
    {
        <div class="text-center mb-4">
            <h2 class="text-black fw-bold">MATCH HISTORY</h2>
            <p class="text-black-50 fw-bold">Player And Team Match Data</p>
        </div>
        <div class="row g-4">
            <div class="col-md-8">
                <div class="card bg-dark border-info text-light shadow h-100">
                    <div class="card-header border-info bg-black d-flex justify-content-between align-items-center p-0">
                        <div class="btn-group w-100">
                            <button class="btn @(statsCategory == StatsCategory.Players ? "btn-info" : "btn-dark")" 
                                    @onclick='() => statsCategory = StatsCategory.Players'>👤 Players</button>
                            <button class="btn @(statsCategory == StatsCategory.Teams ? "btn-info" : "btn-dark")" 
                                    @onclick='() => statsCategory = StatsCategory.Teams'>👥 Teams</button>
                            <button class="btn @(statsCategory == StatsCategory.Characters ? "btn-info" : "btn-dark")" 
                                    @onclick='() => statsCategory = StatsCategory.Characters'>👥 Characters</button>
                        </div>
                    </div>

                   <div class="card-body p-0">
    @if (statsCategory == StatsCategory.Players) 
    {
        <table class="table table-dark table-hover mb-0 text-center reveal-card">
            <thead><tr><th>Player</th><th>W - L</th><th>Streak</th><th>Ratio</th></tr></thead>
            <tbody>
            @foreach (var stat in playerRankings) {
                <tr>
                    <td class="fw-bold">@stat.PlayerName</td>
                    <td><span class="text-info">@stat.Wins</span> - <span class="text-danger">@stat.Losses</span></td>
                    <td>
                        @if (stat.CurrentStreak >= 3) { <span class="badge bg-danger text-warning rivalry-pulse">🔥 @stat.CurrentStreak</span> }
                        else { <span class="text-white">@stat.CurrentStreak</span> }
                    </td>
                    <td class="fw-bold text-info">@stat.Ratio%</td>
                </tr>
            }
            </tbody>
        </table>
    } 
    else if (statsCategory == StatsCategory.Teams) 
    {
        <table class="table table-dark table-hover mb-0 text-center reveal-card">
            <thead><tr><th>Team</th><th>W - L</th><th>Streak</th><th>Ratio</th></tr></thead>
            <tbody>
            @foreach (var team in teamRecords) {
                <tr>
                    <td class="fw-bold text-warning">@team.TeamComposition</td>
                    <td class="text-info">@team.Wins</td>
                    <td class="text-danger">@team.Losses</td>
                    <td>
                        @if (team.CurrentStreak >= 3) { <span class="badge bg-danger text-warning rivalry-pulse">🔥 @team.CurrentStreak</span> }
                        else { <span class="text-white">@team.CurrentStreak</span> }
                    </td>
                    <td class="text-info">@team.Ratio%</td>
                </tr>
            }
            </tbody>
        </table>
    } 
    else if (statsCategory == StatsCategory.Characters) 
    {
        <table class="table table-dark table-hover mb-0 text-center reveal-card">
            <thead>
            <tr>
                <th style="cursor: pointer; user-select: none;" @onclick='() => SortCharacters("name")'>Character Name @GetSortArrow("name")</th>
                <th style="cursor: pointer; user-select: none;" @onclick='() => SortCharacters("wins")'>Wins @GetSortArrow("wins")</th>
                <th style="cursor: pointer; user-select: none;" @onclick='() => SortCharacters("losses")'>Losses @GetSortArrow("losses")</th>
                <th style="cursor: pointer; user-select: none;" @onclick='() => SortCharacters("ratio")'>Win Rate @GetSortArrow("ratio")</th>
                <th style="cursor: pointer; user-select: none;" @onclick=' () => SortCharacters("streak")'> Streak </th>

            </tr>
            </thead>
            <tbody>
            @foreach (var character in characterRecords) {
                <tr>
                    <td class="fw-bold text-white">@character.CharacterName</td>
                    <td class="text-info">@character.Wins</td>
                    <td class="text-danger">@character.Losses</td>
                    <td>
                        @if (character.CurrentStreak >= 3) { <span class="badge bg-danger text-warning rivalry-pulse">🔥 @character.CurrentStreak</span> }
                        else { <span class="text-white">@character.CurrentStreak</span> }
                    </td>
                    <td class="fw-bold text-warning">@character.Ratio%</td>
                </tr>
            }
            }
            </tbody>
        </table>
    }
                   </div>
                    
                </div>
            </div>

            <div class="col-md-4">
                <div class="card bg-dark border-info text-light shadow mb-4">
                    <div class="card-header border-warning bg-black text-warning"><h5>Top 3 Squads</h5></div>
                    <div class="card-body p-0">
                        <table class="table table-dark table-sm mb-0">
                            <tbody>
                            @foreach (var team in teamRecords.Take(3)) {
                                <tr><td class="ps-3 py-2 small">@team.TeamComposition</td><td class="text-end pe-3 text-warning">@team.Wins-@team.Losses</td></tr>
                            }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            
            <div class="col-12">
                <div class="card bg-dark border-secondary text-light shadow">
                    <div class="card-header bg-black"><h5>Full Match History</h5></div>
                    <div class="card-body p-0">
                        <div class="list-group list-group-flush">
                            @for (int i = historicalMatches.Count - 1; i >= 0; i--) {
                                var match = historicalMatches[i];
                                <button class="list-group-item list-group-item-action bg-dark text-light border-secondary p-3" @onclick="() => activeDetailedMatch = match">
        <div class="row align-items-center">
            <div class="col-4">
                @foreach (var name in match.Team1Names)
                {
                    <span class="badge @(match.WinningTeamSide == 1 ? "bg-info text-dark" : "border border-info text-info") me-1">@name</span>
                }
            </div>
            <div class="col-4 text-center">
                <span class="h3 fw-bold text-warning mb-0" style="text-shadow: 0 0 10px rgba(255,193,7,0.3);">
                    @match.Team1Rounds - @match.Team2Rounds
                </span>
            </div>
            <div class="col-4 text-end">
                @foreach (var name in match.Team2Names)
                {
                    <span class="badge @(match.WinningTeamSide == 2 ? "bg-danger text-white" : "border border-danger text-danger") ms-1">@name</span>
                }
            </div>
        </div>
    </button>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
        
    }
    
    @code {

        public enum StatsCategory
        {
            Players,
            Teams,
            Characters
        }
        private string activeCharSortColumn = "ratio"; 
        private bool isCharSortDescending = true;
        
    private List<MatchResult> historicalMatches = new();
    private MatchResult? activeDetailedMatch;
    private StatsCategory statsCategory;
    private List<PlayerRecord> playerRankings = new();
    private List<TeamRecord> teamRecords = new();
    private List<CharacterRecord> characterRecords = new();

    protected override async Task OnInitializedAsync()
    {
        using var db = await DbFactory.CreateDbContextAsync();
        
        var matchesFromDatabase = await db.Matches
            .OrderByDescending(m => m.Id)
            .Take(100) 
            .ToListAsync();

        historicalMatches = matchesFromDatabase;
        playerRankings = PlayerWinRate(historicalMatches);
        teamRecords = TeamWinRate(historicalMatches);
        characterRecords = CharacterWinRate(historicalMatches); 
    }

    private List<PlayerRecord> PlayerWinRate(List<MatchResult> history)
    {
        var playerMap = new Dictionary<string, PlayerRecord>(StringComparer.OrdinalIgnoreCase);

        foreach (var match in history.AsEnumerable().Reverse())
        {
            if (match.Team1Names == null || match.Team2Names == null) continue;

            foreach (var name in match.Team1Names)
            {
                if (!playerMap.TryGetValue(name, out var entry))
                {
                    entry = new PlayerRecord { PlayerName = name };
                    playerMap[name] = entry;
                }

                if (match.WinningTeamSide == 1)
                {
                    entry.Wins++;
                    entry.CurrentStreak++;
                }
                else
                {
                    entry.Losses++;
                    entry.CurrentStreak = 0; 
                }
            }

            foreach (var name in match.Team2Names)
            {
                if (!playerMap.TryGetValue(name, out var entry))
                {
                    entry = new PlayerRecord { PlayerName = name };
                    playerMap[name] = entry;
                }

                if (match.WinningTeamSide == 2)
                {
                    entry.Wins++;
                    entry.CurrentStreak++;
                }
                else
                {
                    entry.Losses++;
                    entry.CurrentStreak = 0;
                }
            }
        }

        return playerMap.Values.OrderByDescending(p => p.Wins).ThenByDescending(p => p.Ratio).ToList();
    }

    private List<TeamRecord> TeamWinRate(List<MatchResult> history)
    {
        var teamMap = new Dictionary<string, TeamRecord>(StringComparer.OrdinalIgnoreCase);

        foreach (var match in history)
        {
            if (match.Team1Names == null || match.Team2Names == null || match.Team1Names.Count == 0 || match.Team2Names.Count == 0) 
                continue;

            // Sort names alphabetically so "Alex & Bob" and "Bob & Alex" count as the same squad
            string team1Key = string.Join(" & ", match.Team1Names.OrderBy(n => n));
            string team2Key = string.Join(" & ", match.Team2Names.OrderBy(n => n));

            if (!teamMap.TryGetValue(team1Key, out var team1Stats))
            {
                team1Stats = new TeamRecord { TeamComposition = team1Key };
                teamMap[team1Key] = team1Stats;
            }

            if (match.WinningTeamSide == 1)
            {
                team1Stats.Wins++;
                team1Stats.CurrentStreak++;
            }
            else
            {
                team1Stats.Losses++;
                team1Stats.CurrentStreak = 0;
            }

            if (!teamMap.TryGetValue(team2Key, out var team2Stats))
            {
                team2Stats = new TeamRecord { TeamComposition = team2Key };
                teamMap[team2Key] = team2Stats;
            }

            if (match.WinningTeamSide == 2)
            {
                team2Stats.Wins++;
                team2Stats.CurrentStreak++;
            }

            else
            {
                team2Stats.Losses++;
                team2Stats.CurrentStreak = 0;
            }
            
            
        }

        return teamMap.Values.OrderByDescending(t => t.Wins).ThenByDescending(t => t.Ratio).ToList();
    }
    
    private List<CharacterRecord> CharacterWinRate(List<MatchResult> history)
    {
        var charMap = new Dictionary<string, CharacterRecord>(StringComparer.OrdinalIgnoreCase);

        foreach (var match in history)
        {
            if (match.Team1Roster == null || match.Team2Roster == null) continue;

            foreach (var character in match.Team1Roster)
            {
                if (string.IsNullOrWhiteSpace(character)) continue;

                if (!charMap.TryGetValue(character, out var record))
                {
                    record = new CharacterRecord { CharacterName = character };
                    charMap[character] = record;
                }

                if (match.WinningTeamSide == 1)
                {
                    record.Wins++;
                    record.CurrentStreak++;
                }

                else
                    
                {
                    record.Losses++;
                    record.CurrentStreak = 0;
                }
            }

            foreach (var character in match.Team2Roster)
            {
                if (string.IsNullOrWhiteSpace(character)) continue;

                if (!charMap.TryGetValue(character, out var record))
                {
                    record = new CharacterRecord { CharacterName = character };
                    charMap[character] = record;
                }

                if (match.WinningTeamSide == 2)
                {
                    record.Wins++;
                    record.CurrentStreak++;
                }
                else
                {
                    record.Losses++;
                    record.CurrentStreak = 0;
                }
            }
        }

        // Sort by highest overall Win Rate, then total Wins for tie-breakers
        return charMap.Values.OrderByDescending(c => c.Ratio).ThenByDescending(c => c.Wins).ToList();
    }
    
    public class PlayerRecord
    {
        public string PlayerName { get; set; } = "";
        public int Wins { get; set; }
        public int Losses { get; set; }
        public int CurrentStreak { get; set; }
        public int Ratio => Wins + Losses == 0 ? 0 : (Wins * 100) / (Wins + Losses);
    }

    public class TeamRecord
    {
        public string TeamComposition { get; set; } = "";
        public int Wins { get; set; }
        public int Losses { get; set; }
        public int CurrentStreak { get; set; }
        public int Ratio => Wins + Losses == 0 ? 0 : (Wins * 100) / (Wins + Losses);
    }
    
    public class CharacterRecord
    {
        public string CharacterName { get; set; } = "";
        public int Wins { get; set; }
        public int Losses { get; set; }
        public int Ratio => Wins + Losses == 0 ? 0 : (Wins * 100) / (Wins + Losses);
        public int CurrentStreak { get; set; }
    }
    
    
    private void SortCharacters(string columnName)
    {
        if (activeCharSortColumn == columnName)
        {
            // Toggle direction if clicking the same column again
            isCharSortDescending = !isCharSortDescending;
        }
        else
        {
            activeCharSortColumn = columnName;
            isCharSortDescending = true; // Default to highest values first
        }

        characterRecords = columnName switch
        {
            "name" => isCharSortDescending ? characterRecords.OrderByDescending(c => c.CharacterName).ToList() : characterRecords.OrderBy(c => c.CharacterName).ToList(),
            "wins" => isCharSortDescending ? characterRecords.OrderByDescending(c => c.Wins).ToList() : characterRecords.OrderBy(c => c.Wins).ToList(),
            "losses" => isCharSortDescending ? characterRecords.OrderByDescending(c => c.Losses).ToList() : characterRecords.OrderBy(c => c.Losses).ToList(),
            "streak" => isCharSortDescending ? characterRecords.OrderByDescending(c=> c.Ratio).ToList() : characterRecords.OrderBy(c => c.CurrentStreak).ToList(),
            "ratio" or _ => isCharSortDescending ? characterRecords.OrderByDescending(c => c.Ratio).ToList() : characterRecords.OrderBy(c => c.Ratio).ToList()
        };
    }

    private string GetSortArrow(string columnName)
    {
        if (activeCharSortColumn != columnName) return "";
        return isCharSortDescending ? "▼" : "▲";
    }
   
 }
</div>