        </table>
    }
                   </div>
                    
                </div>
            </div>

            <div class="col-md-4">
                <div class="card bg-dark border-info text-light shadow mb-4">
                    <div class="card-header border-warning bg-black text-warning"><h5>Top 3 Squads</h5></div>
                    <div class="card-body p-0">
                        <table class="table table-dark table-sm mb-0">
                            <tbody>
                            @foreach (var team in teamRecords.Take(3)) {
                                <tr><td class="ps-3 py-2 small">@team.TeamComposition</td><td class="text-end pe-3 text-warning">@team.Wins-@team.Losses</td></tr>
                            }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            
            <div class="col-12">
                <div class="card bg-dark border-secondary text-light shadow">
                    <div class="card-header bg-black"><h5>Full Match History</h5></div>
                    <div class="card-body p-0">
                        <div class="list-group list-group-flush">
                            @for (int i = historicalMatches.Count - 1; i >= 0; i--) {
                                var match = historicalMatches[i];
                                <button class="list-group-item list-group-item-action bg-dark text-light border-secondary p-3" @onclick="() => activeDetailedMatch = match">
        <div class="row align-items-center">
            <div class="col-4">
                @foreach (var name in match.Team1Names)
                {
                    <span class="badge @(match.WinningTeamSide == 1 ? "bg-info text-dark" : "border border-info text-info") me-1">@name</span>
                }
            </div>
            <div class="col-4 text-center">
                <span class="h3 fw-bold text-warning mb-0" style="text-shadow: 0 0 10px rgba(255,193,7,0.3);">
                    @match.Team1Rounds - @match.Team2Rounds
                </span>
            </div>
            <div class="col-4 text-end">
                @foreach (var name in match.Team2Names)
                {
                    <span class="badge @(match.WinningTeamSide == 2 ? "bg-danger text-white" : "border border-danger text-danger") ms-1">@name</span>
                }
            </div>
        </div>
    </button>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
        
    }
    
    @code {

        public enum StatsCategory
        {
            Players,
            Teams,
            Characters
        }
        private string activeCharSortColumn = "ratio"; 
        private bool isCharSortDescending = true;
        
    private List<MatchResult> historicalMatches = new();
    private MatchResult? activeDetailedMatch;
    private StatsCategory statsCategory;
    private List<PlayerRecord> playerRankings = new();
    private List<TeamRecord> teamRecords = new();
    private List<CharacterRecord> characterRecords = new();
    private string? activePlayerStats;
    
    protected override async Task OnInitializedAsync()
    {
        using var db = await DbFactory.CreateDbContextAsync();
        
        var matchesFromDatabase = await db.Matches
            .OrderByDescending(m => m.Id)
            .Take(100) 
            .ToListAsync();

        historicalMatches = matchesFromDatabase;
        playerRankings = PlayerWinRate(historicalMatches);
        teamRecords = TeamWinRate(historicalMatches);
        characterRecords = CharacterWinRate(historicalMatches); 
    }

    private List<PlayerRecord> PlayerWinRate(List<MatchResult> history)
    {
        var playerMap = new Dictionary<string, PlayerRecord>(StringComparer.OrdinalIgnoreCase);

        foreach (var match in history.AsEnumerable().Reverse())
        {
            if (match.Team1Names == null || match.Team2Names == null) continue;

            foreach (var name in match.Team1Names)
            {
                if (!playerMap.TryGetValue(name, out var entry))
                {
                    entry = new PlayerRecord { PlayerName = name };
                    playerMap[name] = entry;
                }

                if (match.WinningTeamSide == 1)
                {
                    entry.Wins++;
                    entry.PlayerStreak++;
                }
                else
                {
                    entry.Losses++;
                    entry.PlayerStreak = 0; 
                }
            }

            foreach (var name in match.Team2Names)
            {
                if (!playerMap.TryGetValue(name, out var entry))
                {
                    entry = new PlayerRecord { PlayerName = name };
                    playerMap[name] = entry;
                }

                if (match.WinningTeamSide == 2)
                {
                    entry.Wins++;
                    entry.PlayerStreak++;
                }
                else
                {
                    entry.Losses++;
                    entry.PlayerStreak = 0;
                }
            }
        }

        return playerMap.Values.OrderByDescending(p => p.Wins).ThenByDescending(p => p.Ratio).ToList();
    }

    private List<TeamRecord> TeamWinRate(List<MatchResult> history)
    {
        var teamMap = new Dictionary<string, TeamRecord>(StringComparer.OrdinalIgnoreCase);

        foreach (var match in history.AsEnumerable().Reverse())
        {
            if (match.Team1Names == null || match.Team2Names == null || match.Team1Names.Count == 0 || match.Team2Names.Count == 0) 
                continue;

            // Sort names alphabetically so "Alex & Bob" and "Bob & Alex" count as the same squad
            string team1Key = string.Join(" & ", match.Team1Names.OrderBy(n => n));
            string team2Key = string.Join(" & ", match.Team2Names.OrderBy(n => n));

            if (!teamMap.TryGetValue(team1Key, out var team1Stats))
            {
                team1Stats = new TeamRecord { TeamComposition = team1Key };
                teamMap[team1Key] = team1Stats;
            }

            if (match.WinningTeamSide == 1)
            {
                team1Stats.Wins++;
                team1Stats.TeamStreak++;
            }
            else
            {
                team1Stats.Losses++;
                team1Stats.TeamStreak = 0;
            }

            if (!teamMap.TryGetValue(team2Key, out var team2Stats))
            {
                team2Stats = new TeamRecord { TeamComposition = team2Key };
                teamMap[team2Key] = team2Stats;
            }

            if (match.WinningTeamSide == 2)
            {
                team2Stats.Wins++;
                team2Stats.TeamStreak++;
            }

            else
            {
                team2Stats.Losses++;
                team2Stats.TeamStreak = 0;
            }
            
            
        }

        return teamMap.Values.OrderByDescending(t => t.Wins).ThenByDescending(t => t.Ratio).ToList();
    }
    
    private List<CharacterRecord> CharacterWinRate(List<MatchResult> history)
    {
        var charMap = new Dictionary<string, CharacterRecord>(StringComparer.OrdinalIgnoreCase);

        foreach (var match in history.AsEnumerable().Reverse())
        {
            if (match.Team1Roster == null || match.Team2Roster == null) continue;

            foreach (var character in match.Team1Roster)
            {
                if (string.IsNullOrWhiteSpace(character)) continue;

                if (!charMap.TryGetValue(character, out var record))
                {
                    record = new CharacterRecord { CharacterName = character };
                    charMap[character] = record;
                }

                if (match.WinningTeamSide == 1)
                {
                    record.Wins++;
                    record.CharacterStreak++;
                }

                else
                    
                {
                    record.Losses++;
                    record.CharacterStreak = 0;
                }
            }

            foreach (var character in match.Team2Roster)
            {
                if (string.IsNullOrWhiteSpace(character)) continue;

                if (!charMap.TryGetValue(character, out var record))
                {
                    record = new CharacterRecord { CharacterName = character };
                    charMap[character] = record;
                }

                if (match.WinningTeamSide == 2)
                {
                    record.Wins++;
                    record.CharacterStreak++;
                }
                else
                {
                    record.Losses++;
                    record.CharacterStreak = 0;
                }
            }
        }

        // Sort by highest overall Win Rate, then total Wins for tie-breakers
        return charMap.Values.OrderByDescending(c => c.Ratio).ThenByDescending(c => c.Wins).ToList();
    }
    
    public class PlayerRecord
    {
        public string PlayerName { get; set; } = "";
        public int Wins { get; set; }
        public int Losses { get; set; }
        public int PlayerStreak { get; set; }
        public int Ratio => Wins + Losses == 0 ? 0 : (Wins * 100) / (Wins + Losses);
    }

    public class TeamRecord
    {
        public string TeamComposition { get; set; } = "";
        public int Wins { get; set; }
        public int Losses { get; set; }
        public int TeamStreak { get; set; }
        public int Ratio => Wins + Losses == 0 ? 0 : (Wins * 100) / (Wins + Losses);
    }
    
    public class CharacterRecord
    {
        public string CharacterName { get; set; } = "";
        public int Wins { get; set; }
        public int Losses { get; set; }
        public int Ratio => Wins + Losses == 0 ? 0 : (Wins * 100) / (Wins + Losses);
        public int CharacterStreak { get; set; }
    }
    
    
    private void SortCharacters(string columnName)
    {
        if (activeCharSortColumn == columnName)
        {
            // Toggle direction if clicking the same column again
            isCharSortDescending = !isCharSortDescending;
        }
        else
        {
            activeCharSortColumn = columnName;
            isCharSortDescending = true; // Default to highest values first
        }

        characterRecords = columnName switch
        {
            "name" => isCharSortDescending ? characterRecords.OrderByDescending(c => c.CharacterName).ToList() : characterRecords.OrderBy(c => c.CharacterName).ToList(),
            "wins" => isCharSortDescending ? characterRecords.OrderByDescending(c => c.Wins).ToList() : characterRecords.OrderBy(c => c.Wins).ToList(),
            "losses" => isCharSortDescending ? characterRecords.OrderByDescending(c => c.Losses).ToList() : characterRecords.OrderBy(c => c.Losses).ToList(),
            "streak" => isCharSortDescending ? characterRecords.OrderByDescending(c=> c.CharacterStreak).ToList() : characterRecords.OrderBy(c => c.CharacterStreak).ToList(),
            "ratio" or _ => isCharSortDescending ? characterRecords.OrderByDescending(c => c.Ratio).ToList() : characterRecords.OrderBy(c => c.Ratio).ToList()
        };
    }

    private string GetSortArrow(string columnName)
    {
        if (activeCharSortColumn != columnName) return "";
        return isCharSortDescending ? "▼" : "▲";
    }
   public class PlayerProfileAnalysis
{
    public List<KeyValuePair<string, int>> BestCharacters { get; set; } = new();
    public List<KeyValuePair<string, int>> WorstCharacters { get; set; } = new();
    public List<KeyValuePair<string, int>> BestTeams { get; set; } = new();
    public List<KeyValuePair<string, int>> WorstTeams { get; set; } = new();
    public List<KeyValuePair<string, int>> BestMatchups { get; set; } = new();
    public List<KeyValuePair<string, int>> WorstMatchups { get; set; } = new();
}

private PlayerProfileAnalysis GetPlayerProfileData(string targetPlayer)
{
    var profile = new PlayerProfileAnalysis();
    
    var charWins = new Dictionary<string, int>(StringComparer.OrdinalIgnoreCase);
    var charTotal = new Dictionary<string, int>(StringComparer.OrdinalIgnoreCase);
    
    var teamWins = new Dictionary<string, int>(StringComparer.OrdinalIgnoreCase);
    var teamTotal = new Dictionary<string, int>(StringComparer.OrdinalIgnoreCase);
    
    var rivalWins = new Dictionary<string, int>(StringComparer.OrdinalIgnoreCase);
    var rivalTotal = new Dictionary<string, int>(StringComparer.OrdinalIgnoreCase);

    foreach (var match in historicalMatches)
    {
        if (match.Team1Names == null || match.Team2Names == null) continue;

        bool inTeam1 = match.Team1Names.Contains(targetPlayer, StringComparer.OrdinalIgnoreCase);
        bool inTeam2 = match.Team2Names.Contains(targetPlayer, StringComparer.OrdinalIgnoreCase);

        if (!inTeam1 && !inTeam2) continue; // Skip if this player wasn't in this match

        int mySide = inTeam1 ? 1 : 2;
        bool isWin = match.WinningTeamSide == mySide;

        var myTeamNames = mySide == 1 ? match.Team1Names : match.Team2Names;
        var myTeamRoster = mySide == 1 ? match.Team1Roster : match.Team2Roster;
        var enemyTeamNames = mySide == 1 ? match.Team2Names : match.Team1Names;

        int playerIdx = myTeamNames.FindIndex(n => n.Equals(targetPlayer, StringComparison.OrdinalIgnoreCase));

        if (myTeamRoster != null && playerIdx >= 0)
        {
            var playerCharacters = myTeamRoster.Skip(playerIdx * 5).Take(5).Where(c => !string.IsNullOrWhiteSpace(c));
            foreach (var character in playerCharacters)
            {
                charTotal[character] = charTotal.GetValueOrDefault(character) + 1;
                if (isWin) charWins[character] = charWins.GetValueOrDefault(character) + 1;
            }
        }

        var allies = myTeamNames.Where(n => !n.Equals(targetPlayer, StringComparison.OrdinalIgnoreCase)).OrderBy(n => n).ToList();
        if (allies.Any())
        {
            string teamKey = string.Join(" & ", allies);
            teamTotal[teamKey] = teamTotal.GetValueOrDefault(teamKey) + 1;
            if (isWin) teamWins[teamKey] = teamWins.GetValueOrDefault(teamKey) + 1;
        }

        foreach (var rival in enemyTeamNames)
        {
            if (string.IsNullOrWhiteSpace(rival)) continue;
            rivalTotal[rival] = rivalTotal.GetValueOrDefault(rival) + 1;
            if (isWin) rivalWins[rival] = rivalWins.GetValueOrDefault(rival) + 1;
        }
    }

    var charRates = charTotal.Select(c => new KeyValuePair<string, int>(c.Key, (charWins.GetValueOrDefault(c.Key) * 100) / c.Value)).ToList();
    var teamRates = teamTotal.Select(t => new KeyValuePair<string, int>(t.Key, (teamWins.GetValueOrDefault(t.Key) * 100) / t.Value)).ToList();
    var rivalRates = rivalTotal.Select(r => new KeyValuePair<string, int>(r.Key, (rivalWins.GetValueOrDefault(r.Key) * 100) / r.Value)).ToList();

    profile.BestCharacters = charRates.OrderByDescending(c => c.Value).ToList();
    profile.WorstCharacters = charRates.OrderBy(c => c.Value).ToList();

    profile.BestTeams = teamRates.OrderByDescending(t => t.Value).ToList();
    profile.WorstTeams = teamRates.OrderBy(t => t.Value).ToList();

    profile.BestMatchups = rivalRates.OrderByDescending(r => r.Value).ToList();
    profile.WorstMatchups = rivalRates.OrderBy(r => r.Value).ToList();

    return profile;
}
