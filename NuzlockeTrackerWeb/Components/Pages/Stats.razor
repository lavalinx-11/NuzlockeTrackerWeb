            </div>
            <button class="btn btn-outline-secondary" @onclick="() => activePlayerStats = null">
                ← Back to Leaderboards
            </button>
        </div>

        <div class="row g-4">
            <div class="col-md-4">
                <div class="card bg-black border-secondary h-100">
                    <div class="card-header bg-dark text-center py-2"><h5 class="mb-0 text-white">Character Pools</h5></div>
                    <div class="card-body p-3">
                        <h6 class="text-success fw-bold small text-uppercase mb-2">🔥 Top Performers</h6>
                        @foreach(var c in profile.BestCharacters.Take(3)) {
                            <div class="d-flex justify-content-between border-bottom border-secondary py-1 small">
                                <span>• @c.Key</span> <span class="text-success fw-bold">@c.Value% WR</span>
                            </div>
                        }
                        <h6 class="text-danger fw-bold small text-uppercase mt-4 mb-2">📉 Low Win Rate</h6>
                        @foreach(var c in profile.WorstCharacters.Take(3)) {
                            <div class="d-flex justify-content-between border-bottom border-secondary py-1 small">
                                <span>• @c.Key</span> <span class="text-danger fw-bold">@c.Value% WR</span>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card bg-black border-secondary h-100">
                    <div class="card-header bg-dark text-center py-2"><h5 class="mb-0 text-white">Squad Synergy</h5></div>
                    <div class="card-body p-3">
                        <h6 class="text-info fw-bold small text-uppercase mb-2">🤝 Strongest Synergies</h6>
                        @foreach(var t in profile.BestTeams.Take(3)) {
                            <div class="d-flex flex-column border-bottom border-secondary py-1 small mb-1">
                                <span class="text-truncate text-warning">@t.Key</span>
                                <span class="text-info text-end fw-bold" style="font-size:0.75rem;">@t.Value% WR</span>
                            </div>
                        }
                        <h6 class="text-danger fw-bold small text-uppercase mt-3 mb-2">⚠️ Weakest Synergies</h6>
                        @foreach(var t in profile.WorstTeams.Take(3)) {
                            <div class="d-flex flex-column border-bottom border-secondary py-1 small mb-1">
                                <span class="text-truncate text-white-50">@t.Key</span>
                                <span class="text-danger text-end fw-bold" style="font-size:0.75rem;">@t.Value% WR</span>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card bg-black border-secondary h-100">
                    <div class="card-header bg-dark text-center py-2"><h5 class="mb-0 text-white">Rivalries</h5></div>
                    <div class="card-body p-3">
                        <h6 class="text-success fw-bold small text-uppercase mb-2">⚔️ Favored Matchups</h6>
                        @foreach(var m in profile.BestMatchups.Take(3)) {
                            <div class="d-flex justify-content-between border-bottom border-secondary py-1 small">
                                <span>vs @m.Key</span> <span class="text-success fw-bold">@m.Value% WR</span>
                            </div>
                        }
                        <h6 class="text-danger fw-bold small text-uppercase mt-4 mb-2">💀 Nemesis Matchups</h6>
                        @foreach(var m in profile.WorstMatchups.Take(3)) {
                            <div class="d-flex justify-content-between border-bottom border-secondary py-1 small">
                                <span>vs @m.Key</span> <span class="text-danger fw-bold">@m.Value% WR</span>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
}

    else
    {
        <div class="text-center mb-4">
            <h2 class="text-black fw-bold">MATCH HISTORY</h2>
            <p class="text-black-50 fw-bold">Player And Team Match Data</p>
        </div>
        <div class="row g-4">
            <div class="col-md-8">
                <div class="card bg-dark border-info text-light shadow h-100">
                    <div class="card-header border-info bg-black d-flex justify-content-between align-items-center p-0">
                        <div class="btn-group w-100">
                            <button class="btn @(statsCategory == StatsCategory.Players ? "btn-info" : "btn-dark")" 
                                    @onclick='() => statsCategory = StatsCategory.Players'>👤 Players</button>
                            <button class="btn @(statsCategory == StatsCategory.Teams ? "btn-info" : "btn-dark")" 
                                    @onclick='() => statsCategory = StatsCategory.Teams'>👥 Teams</button>
                            <button class="btn @(statsCategory == StatsCategory.Characters ? "btn-info" : "btn-dark")" 
                                    @onclick='() => statsCategory = StatsCategory.Characters'>👥 Characters</button>
                        </div>
                    </div>

                   <div class="card-body p-0">
    @if (statsCategory == StatsCategory.Players) 
    {
        <table class="table table-dark table-hover mb-0 text-center reveal-card">
            <thead><tr><th>Player</th><th>W - L</th><th>Streak</th><th>Ratio</th></tr></thead>
            <tbody>
            @foreach (var stat in playerRankings)
            {
                <tr @onclick="() => activePlayerStats = stat.PlayerName" style="cursor: pointer;" class="align-middle"></tr>
                    <td class="fw-bold text-info text-start ps-4">
                        <button class="btn btn-sm btn-outline-info me-2">📊</button> @stat.PlayerName
                    </td>
                    <td><span class="text-info">@stat.Wins</span> - <span class="text-danger">@stat.Losses</span></td>
                    <td>
                        @if (stat.PlayerStreak >= 3)
                        {
                            <span class="badge bg-danger text-warning rivalry-pulse">🔥 @stat.PlayerStreak</span>
                        }
                        else
                        {
                            <span class="text-white">@stat.PlayerStreak</span>
                        }
                    </td>
                    <td class="fw-bold text-info">@stat.Ratio%</td>
            }
            </tbody>
        </table>
    } 
    else if (statsCategory == StatsCategory.Teams) 
    {
        <table class="table table-dark table-hover mb-0 text-center reveal-card">
            <thead><tr><th>Team</th><th>Wins</th><th>Losses</th><th>Streak</th><th>Ratio</th></tr></thead>
            <tbody>
            @foreach (var team in teamRecords) {
                <tr>
                    <td class="fw-bold text-warning">@team.TeamComposition</td>
                    <td class="text-info">@team.Wins</td>
                    <td class="text-danger">@team.Losses</td>
                    <td>
                        @if (team.TeamStreak >= 3) { <span class="badge bg-danger text-warning rivalry-pulse">🔥 @team.TeamStreak</span> }
                        else { <span class="text-white">@team.TeamStreak</span> }
                    </td>
                    <td class="text-info">@team.Ratio%</td>
                </tr>
            }
            </tbody>
        </table>
    } 
    else if (statsCategory == StatsCategory.Characters) 
    {
        <table class="table table-dark table-hover mb-0 text-center reveal-card">
            <thead>
            <tr>
                <th style="cursor: pointer; user-select: none;" @onclick='() => SortCharacters("name")'>Character Name @GetSortArrow("name")</th>
                <th style="cursor: pointer; user-select: none;" @onclick='() => SortCharacters("wins")'>Wins @GetSortArrow("wins")</th>
                <th style="cursor: pointer; user-select: none;" @onclick='() => SortCharacters("losses")'>Losses @GetSortArrow("losses")</th>
                <th style="cursor: pointer; user-select: none;" @onclick=' () => SortCharacters("streak")'> Streak </th>
                <th style="cursor: pointer; user-select: none;" @onclick='() => SortCharacters("ratio")'>Win Rate @GetSortArrow("ratio")</th>

            </tr>
            </thead>
            <tbody>
            @foreach (var character in characterRecords) {
                <tr>
                    <td class="fw-bold text-white">@character.CharacterName</td>
                    <td class="text-info">@character.Wins</td>
                    <td class="text-danger">@character.Losses</td>
                    <td>
                        @if (character.CharacterStreak >= 3) { <span class="badge bg-danger text-warning rivalry-pulse">🔥 @character.CharacterStreak</span> }
                        else { <span class="text-white">@character.CharacterStreak</span> }
