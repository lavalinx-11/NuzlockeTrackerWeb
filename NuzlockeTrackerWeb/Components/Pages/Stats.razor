                    @activeDetailedMatch.Team1Rounds - @activeDetailedMatch.Team2Rounds
                </div>
            </div>
            <div class="col-5">
                @foreach(var name in activeDetailedMatch.Team2Names) {
                    <h3 class="badge bg-danger text-white fs-4 m-1">@name</h3>
                }
            </div>
        </div>

        @* --- BANNED CHARACTERS --- *@
        @if (activeDetailedMatch.BanList.Any())
        {
            <div class="border-top border-secondary pt-3 text-center">
                <h6 class="text-uppercase tracking-wider text-danger fw-bold mb-2" style="font-size: 0.85rem; letter-spacing: 1px;">
                    Banned Characters
                </h6>
                <div class="d-flex flex-wrap gap-2 justify-content-center">
                    @foreach (var bannedChar in activeDetailedMatch.BanList)
                    {
                        <span class="badge bg-black border border-danger text-danger px-3 py-2 fw-bold">
                            @bannedChar
                        </span>
                    }
                </div>
            </div>
        }
    </div>

    @* --- PLAYER CHARACTER PICKS --- *@
    <div class="card-body bg-black p-4 rounded-bottom border border-top-0 border-secondary">
        <div class="row">
           <!-- Team 1 Picks -->
<div class="col-6 border-end border-secondary">
    <h6 class="text-info mb-3 fw-bold">TEAM 1 PICKS</h6>
    <div class="d-flex flex-column gap-3">
        @for (int i = 0; i < activeDetailedMatch.Team1Names.Count; i++)
        {
            var player = activeDetailedMatch.Team1Names[i];
            
           @* --- The 5 Characters Picked By This Player --- *@
            var playerCharacters = activeDetailedMatch.Team1Roster?
                .Skip(i * 5)
                .Take(5)
                .Where(c => !string.IsNullOrWhiteSpace(c))
                .ToList() ?? new List<string>();

